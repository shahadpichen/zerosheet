# ZeroSheet local infrastructure settings
# ========================================
#
# This file documents every environment variable required by the local IAM
# laboratory. It is safe to commit because every credential below is an
# obvious local-development placeholder, not a usable production secret.
#
# Copy this file to ".env" before starting Docker Compose. The real ".env" is
# ignored by Git and is the place where each developer chooses their own local
# passwords. Production will use mounted secret files instead of this format.
#
# None of these passwords protect real data. Never reuse them on RackNerd,
# GitHub, Google, or any other account.

# PostgreSQL creates this bootstrap administrator the first time the Docker
# volume is initialized. Only initialization and controlled migrations should
# use it. Runtime services receive the narrower accounts documented below.
POSTGRES_ADMIN_USER=zerosheet_admin
POSTGRES_ADMIN_PASSWORD=local-only-postgres-admin-change-me

# Port 5434 avoids colliding with a PostgreSQL server already using the normal
# host port 5432. Inside Docker, PostgreSQL still listens on its standard 5432.
POSTGRES_HOST_PORT=5434
POSTGRES_MEMORY_LIMIT=384m

# ZeroSheet owns product records such as internal users, organizations,
# sessions, audit events, and encrypted key-envelope metadata.
ZEROSHEET_DB_NAME=zerosheet
ZEROSHEET_DB_USER=zerosheet_app
ZEROSHEET_DB_PASSWORD=local-only-zerosheet-db-change-me

# The API runs on the host during this learning milestone, so it reaches the
# loopback-bound PostgreSQL port rather than Docker's internal service name.
# RackNerd will provide its private database hostname and require TLS.
ZEROSHEET_DB_HOST=127.0.0.1
ZEROSHEET_DB_TLS=false

# OpenFGA is introduced in a later milestone, but its isolated database and
# runtime role are reserved now so the database boundary is established once.
OPENFGA_DB_NAME=openfga
OPENFGA_DB_USER=openfga_app
OPENFGA_DB_PASSWORD=local-only-openfga-db-change-me

# OpenFGA is the relationship-authorization decision service. Only its HTTP
# endpoint is exposed to the loopback interface; PostgreSQL and gRPC remain on
# the private Compose network. A pre-shared bearer key protects this local lab
# until the mTLS milestone uses the workload identities introduced by SPIRE.
OPENFGA_HTTP_PORT=8082
OPENFGA_API_URL=http://127.0.0.1:8082
OPENFGA_PRESHARED_KEY=local-only-openfga-api-key-change-me
OPENFGA_MEMORY_LIMIT=256m
OPENFGA_STORE_NAME=zerosheet

# `pnpm infra:authorization:provision` creates `.env.openfga` containing the
# generated store and immutable authorization-model IDs. Those identifiers are
# intentionally not guessed or committed because OpenFGA creates them.

# OPA is the contextual policy decision service. It is stateless in this
# milestone: reviewed Rego files are mounted read-only, while PostgreSQL facts
# are supplied in each API decision request. The host binding is loopback-only.
OPA_HTTP_PORT=8181
OPA_API_URL=http://127.0.0.1:8181
OPA_MEMORY_LIMIT=128m
OPA_REQUEST_TIMEOUT_MS=5000

# SPIRE uses no committed password. These limits only reserve enough RAM for
# its workload-identity control plane and per-node agent on a small lab VPS.
# Signing keys and registration state live in dedicated Docker volumes.
SPIRE_SERVER_MEMORY_LIMIT=192m
SPIRE_AGENT_MEMORY_LIMIT=128m

# The private Node mTLS listener and short-lived probe containers are small.
# This limit is independent from SPIRE because identity issuance and workload
# execution are separate failure and scaling boundaries.
ZEROSHEET_WORKLOAD_MEMORY_LIMIT=192m

# ONE Google OAuth web client serves sign-in and optional Drive/Sheets access.
# The API/BFF uses this pair for both flows; never put the secret in VITE_ vars.
# Register BOTH exact local redirects on the same Google OAuth web client:
# http://localhost:3001/auth/callback
# http://localhost:3001/google/storage/callback
# If the API port changes, update both registered redirects to match it.
GOOGLE_OAUTH_CLIENT_ID=replace-with-google-web-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-google-web-client-secret

# Leave this empty for consumer Google accounts. A production enterprise can
# set its Workspace domain to give Google an account-selection hint; ZeroSheet
# authorization must still rely on organization membership, not this hint.
GOOGLE_OIDC_HOSTED_DOMAIN=

# With storage enabled, sign-in requests openid/email/profile plus drive.file
# and drive.appdata in ONE consent flow using the SAME client above. Enable
# Drive API and Sheets API on the Google Cloud project before turning this on.
# Google can combine previously consented scopes; it does not create an
# independent revocation boundary just because the callback is different.
GOOGLE_STORAGE_OAUTH_ENABLED=false

# This independent 32-byte base64url key encrypts Google refresh tokens before
# PostgreSQL storage. The all-zero value is an obvious local-only placeholder;
# generate a random production value, store it outside Git, and back it up in a
# password manager. It is not related to any workbook or recovery phrase.
GOOGLE_STORAGE_TOKEN_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
GOOGLE_STORAGE_OAUTH_TRANSACTION_TTL_SECONDS=600

# The API URL constructs Google's exact registered redirect URI. Exact values
# prevent an authorization response from being redirected to an attacker-
# controlled destination. Binding Fastify and Vite to the same
# `localhost` name also keeps their host-only authentication cookies consistent;
# browsers correctly treat `localhost` and `127.0.0.1` as different hosts.
API_HOST=localhost
ZEROSHEET_API_URL=http://localhost:3001
ZEROSHEET_WEB_URL=http://localhost:5173

# Local HTTP cannot use Secure cookies. Production startup refuses false here
# and automatically changes the cookie names to the protected __Host- prefix.
ZEROSHEET_COOKIE_SECURE=false

# Login transactions are deliberately short-lived, while product sessions have
# an eight-hour absolute lifetime. Idle expiry and organization-specific session
# policy will be added with enterprise governance rather than guessed here.
ZEROSHEET_OIDC_TRANSACTION_TTL_SECONDS=600
ZEROSHEET_SESSION_TTL_SECONDS=28800
