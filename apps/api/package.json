{
  "name": "@zerosheet/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "dev": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.openfga --import=tsx --watch src/server.ts",
    "start": "node --env-file-if-exists=../../.env --env-file-if-exists=../../.env.openfga dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@openfga/sdk": "0.9.7",
    "@zerosheet/contracts": "workspace:*",
    "fastify": "^5.0.0",
    "openid-client": "^6.8.7",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "tsx": "^4.0.0"
  }
}
