# syntax=docker/dockerfile:1.7

# Keycloak's official optimized-container pattern performs augmentation once at
# image build time. Startup therefore validates configuration and connects to
# PostgreSQL without rebuilding the server on every restart.
FROM quay.io/keycloak/keycloak:26.7.3 AS build
ENV KC_DB=postgres
ENV KC_HEALTH_ENABLED=true
ENV KC_METRICS_ENABLED=true
RUN /opt/keycloak/bin/kc.sh build

FROM quay.io/keycloak/keycloak:26.7.3 AS runtime
COPY --from=build /opt/keycloak/ /opt/keycloak/
COPY --chmod=0755 infra/docker/keycloak-entrypoint.sh /opt/keycloak/bin/zerosheet-entrypoint.sh
COPY --chown=1000:1000 infra/keycloak/realm/zerosheet-production-realm.json /opt/keycloak/data/import/zerosheet-realm.json

ENTRYPOINT ["/opt/keycloak/bin/zerosheet-entrypoint.sh"]
CMD ["start", "--optimized", "--import-realm"]
