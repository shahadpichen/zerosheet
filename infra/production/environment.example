# Copy this file to a root-owned path outside the Git checkout. Docker Compose
# reads names and non-secret IDs here; credential values live in individual
# files under ZEROSHEET_SECRET_DIRECTORY and never in this document.
ZEROSHEET_DOMAIN=sheets.example.com
ZEROSHEET_ACME_EMAIL=operator@example.com

# Use absolute host paths. `state` receives only the generated non-secret
# OpenFGA IDs; `secrets` must be backed up through an encrypted secret manager.
ZEROSHEET_SECRET_DIRECTORY=/etc/zerosheet/secrets
ZEROSHEET_STATE_DIRECTORY=/var/lib/zerosheet/state

POSTGRES_ADMIN_USER=zerosheet_admin
ZEROSHEET_DB_NAME=zerosheet
ZEROSHEET_DB_USER=zerosheet_app
ZEROSHEET_AUDIT_DB_USER=zerosheet_auditor
OPENFGA_DB_NAME=openfga
OPENFGA_DB_USER=openfga_app

OPENFGA_STORE_NAME=ZeroSheet Production

# Replace these after the bootstrap profile writes openfga.env. They are public
# immutable identifiers, but the API refuses placeholders or malformed IDs.
OPENFGA_STORE_ID=01H00000000000000000000000
OPENFGA_AUTHORIZATION_MODEL_ID=01H00000000000000000000001

# One web client serves login and optional Drive/Sheets access. Its secret is
# mounted once from google_oauth_client_secret; never place it in this file.
GOOGLE_OAUTH_CLIENT_ID=replace-with-google-web-client.apps.googleusercontent.com
GOOGLE_OIDC_HOSTED_DOMAIN=
GOOGLE_STORAGE_OAUTH_ENABLED=false

# Conservative limits fit the application stack close to a 2 GB VPS boundary.
# That size is suitable for a learning/alpha node, not HA or a traffic SLA.
POSTGRES_MEMORY_LIMIT=320m
OPENFGA_MEMORY_LIMIT=160m
OPA_MEMORY_LIMIT=64m
ZEROSHEET_API_MEMORY_LIMIT=192m
CADDY_MEMORY_LIMIT=64m
ZEROSHEET_LOG_LEVEL=info
ZEROSHEET_SHARING_DRIFT_MINUTES=30
