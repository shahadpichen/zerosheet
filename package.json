{
  "name": "zerosheet",
  "version": "0.0.0",
  "private": true,
  "description": "End-to-end encrypted spreadsheets with enterprise identity and access management.",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present build",
    "clean": "pnpm --recursive --if-present clean",
    "dev": "pnpm --parallel --filter @zerosheet/api --filter @zerosheet/web dev",
    "dev:api": "pnpm --filter @zerosheet/api dev",
    "dev:web": "pnpm --filter @zerosheet/web dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:db:migrate": "bash infra/scripts/migrate-zerosheet-database.sh",
    "infra:federation:google:configure": "bash infra/scripts/configure-google-identity-provider.sh",
    "infra:federation:google:verify": "bash infra/scripts/verify-google-identity-provider.sh",
    "infra:auth:config": "docker compose --env-file .env --file infra/compose.yaml --profile auth-lab config --quiet",
    "infra:auth:down": "docker compose --env-file .env --file infra/compose.yaml --profile auth-lab down",
    "infra:auth:logs": "docker compose --env-file .env --file infra/compose.yaml --profile auth-lab logs --follow postgres keycloak",
    "infra:auth:up": "docker compose --env-file .env --file infra/compose.yaml --profile auth-lab up --detach --wait",
    "infra:auth:verify": "bash infra/scripts/verify-auth-foundation.sh",
    "infra:authorization:config": "docker compose --env-file .env --file infra/compose.yaml --profile auth-lab --profile authorization-lab --profile contextual-authorization-lab config --quiet",
    "infra:authorization:model:test": "bash infra/scripts/test-openfga-model.sh",
    "infra:authorization:provision": "bash infra/scripts/provision-openfga-authorization.sh",
    "infra:authorization:up": "docker compose --env-file .env --file infra/compose.yaml --profile auth-lab --profile authorization-lab --profile contextual-authorization-lab up --detach --wait",
    "infra:authorization:verify": "bash infra/scripts/verify-authorization-foundation.sh",
    "infra:contextual-authorization:policy:test": "bash infra/scripts/test-opa-policy.sh",
    "infra:contextual-authorization:verify": "bash infra/scripts/verify-contextual-authorization.sh",
    "infra:lifecycle:verify": "bash infra/scripts/verify-enterprise-lifecycle.sh",
    "infra:product:verify": "bash infra/scripts/verify-product-authorization-lifecycle.sh",
    "infra:oidc:verify": "bash infra/scripts/verify-oidc-bff.sh",
    "infra:workload-identity:config": "docker compose --env-file .env --file infra/compose.yaml --profile workload-identity-lab --profile workload-identity-probes config --quiet",
    "infra:workload-identity:down": "docker compose --env-file .env --file infra/compose.yaml --profile workload-identity-lab stop spire-agent spire-server",
    "infra:workload-identity:logs": "docker compose --env-file .env --file infra/compose.yaml --profile workload-identity-lab logs --follow spire-server spire-agent",
    "infra:workload-identity:provision": "bash infra/scripts/provision-spire-workloads.sh",
    "infra:workload-identity:verify": "bash infra/scripts/verify-spiffe-workload-identities.sh",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "prepare": "node .husky/install.mjs",
    "test": "pnpm --recursive --if-present test && pnpm infra:authorization:model:test && pnpm infra:contextual-authorization:policy:test",
    "typecheck": "pnpm --recursive --if-present typecheck"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.9.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.69.0",
    "vitest": "^3.2.0"
  }
}
